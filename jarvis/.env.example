# Copiá este archivo como ".env" y completalo.

# Clave GRATIS de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=pega_tu_clave_aca
GEMINI_MODELO=gemini-2.5-flash

PALABRA_CLAVE=jarvis

# Cómo se controla la luz: simulado | tuya | homeassistant
LUZ_TIPO=simulado

# --- Foco o enchufe inteligente Tuya / Smart Life (ver LEEME.md para sacar estos datos)
TUYA_ID=
TUYA_IP=
TUYA_LOCAL_KEY=
TUYA_VERSION=3.3
# 1 para enchufes; muchos focos usan 20
TUYA_DPS=1

# --- Home Assistant
HA_URL=http://192.168.0.10:8123
HA_TOKEN=
HA_ENTIDAD=light.habitacion
